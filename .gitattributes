# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Windows-native tooling expects CRLF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binaries — never diffed, never line-ending converted.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Generated files: collapsed in diffs and excluded from language stats.
package-lock.json  linguist-generated=true -diff

# The site is a Vue/TypeScript project — don't let CV templates skew the
# language breakdown on the repository page.
docs/cv/*.html      linguist-documentation=true
scripts/cv/cv.html  linguist-documentation=true

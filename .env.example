# Portfolio content mode: demo | review | production
#   demo       — demonstration content with a visible banner
#   review     — owner content; unfinished fields allowed and visibly tagged
#   production — the build FAILS while placeholders, demo projects, or
#                unverified required content remain
# The mode is baked in at build time (static generation). Set it BEFORE
# running `nuxt generate`, and in Vercel project settings before deploying.
NUXT_PUBLIC_PORTFOLIO_MODE=review

# Canonical site URL used for SEO metadata, sitemap, and canonical links.
# chamroeunhongleng.me is the intended production domain but was NOT serving
# at build time (connection refused) — verify DNS + hosting before production.
NUXT_PUBLIC_SITE_URL=https://chamroeunhongleng.me
